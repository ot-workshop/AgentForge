{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.protocol/v1/block.json",
  "title": "AgentForge block (blocks/<id>/v<n>.yaml): a reusable, versioned stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "agent", "inputs", "outputs", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "agent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*@[0-9]+$" },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "type": "object", "properties": { "type": { "type": "string" } } }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "run": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_s": { "type": "integer", "minimum": 1 },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "on_exhausted": { "type": "string", "pattern": "^(human_gate:.+|fail)$" }
      }
    }
  }
}
